<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Where the FinPet backend runs: your Northflank public URL (https, no trailing slash), e.g.
	     https://p01--finpet--abc123.code.run . For a local server use http://localhost:8000 (simulator)
	     or your computer's LAN IP (real iPhone). -->
	<key>FinPetBackendURL</key>
	<string>https://REPLACE-WITH-YOUR-NORTHFLANK-URL</string>
	<!-- Allow plain-HTTP calls to localhost / local-network IPs during development. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>FinPet connects to a local development server when you run the backend on your own network.</string>
</dict>
</plist>
