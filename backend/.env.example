# FinPet backend secrets. Copy to backend/.env (git-ignored) and fill in.

# Billing-enabled Gemini Developer API key (image + video models are not on the free tier).
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Accounts (Supabase). Project settings -> API. The service role key is a SECRET: server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Signing secret for login tokens (min 32 chars). Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# JWT_EXPIRE_DAYS=7

# Optional overrides (defaults shown). Keep clips short and small to save credits.
# GEMINI_MODEL=gemini-3.1-flash-image
# VIDEO_MODEL=gemini-omni-1.2-flash
# ANIM_SECONDS=3          # whole seconds, 3-15 (3 is the cheapest)
# ANIM_RESOLUTION=360p    # 360p is the cheapest
# ANIM_FPS=10             # frames kept per second of video
# ANIM_FRAME_HEIGHT=512   # max frame height sent to the app
