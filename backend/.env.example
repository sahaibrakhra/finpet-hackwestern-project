# FinPet backend secrets. Copy to backend/.env (git-ignored) and fill in.

# Billing-enabled Gemini Developer API key (image models are not on the free tier).
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: image model used to generate the avatar.
GEMINI_MODEL=gemini-3.1-flash-image
