# Copy to .env (never commit .env). All variables are optional.

# Mesh provider: mock (default, offline mannequin) | hf_space (free public HF Space, photo leaves your machine) | local_gpu (stub)
PROVIDER=none

# Artificial delay (seconds) in the mock provider so the progress UI is visible
MOCK_DELAY_S=4

# Local background removal with rembg (downloads a ~170 MB model on first use). true|false
REMBG=true
# Local auto-rig after mesh generation: humanoid skeleton + skin weights + looping idle clip. CPU only. true|false
RIG=true
# Project the photo's colours onto untextured meshes (front projection, CPU only). true|false
COLORIZE=true
# rembg model (u2net ~170 MB; u2netp is smaller/faster, lower quality)
REMBG_MODEL=u2net

# Optional Gemini stylize step. Runs only if STYLIZE=true AND GEMINI_API_KEY is set.
# NOTE: this sends your photo to Google.
STYLIZE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# --- hf_space provider ---
# Hugging Face Space to call (owner/name). Must be a public image-to-3D Space.
HF_SPACE_ID=tencent/Hunyuan3D-2
# Leave empty to auto-detect the image-to-3D endpoint via view_api(); otherwise e.g. /shape_generation
HF_SPACE_ENDPOINT=
# Optional extra/override parameters for the endpoint as JSON, e.g. {"seed": 1}
HF_SPACE_ARGS_JSON=
# Optional free token (https://huggingface.co/settings/tokens, "Read") - larger GPU quota
HF_TOKEN=
# Max seconds to wait for the Space (must be below JOB_TIMEOUT_S)
HF_TIMEOUT_S=420

# A job stuck longer than this many seconds is marked as an error
JOB_TIMEOUT_S=600

# Logging level: DEBUG|INFO|WARNING
LOG_LEVEL=INFO

# --- PROVIDER=hf_rigged (photo -> textured mesh -> auto-rigged GLB via TRELLIS + UniRig Space) ---
# Needs a Hugging Face token: ZeroGPU rejects anonymous requests for the 450 s GPU job this Space asks for.
# HF_RIG_SPACE_ID=kirikir13/image-to-rigged-3d
# HF_RIG_RESOLUTION=512
# HF_RIG_DECIMATION=100000
# HF_RIG_TEXTURE_SIZE=1024
